{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "huaweicloud-open-mcp": {
      "type": "local",
      "command": ["uv", "run", "huaweicloud-open-mcp", "--policy", "configs/safety-policy.example.json", "--mode", "data,openapi", "--hints", "configs/help_completions.json", "--deprecated-index", "configs/deprecated.json"],
