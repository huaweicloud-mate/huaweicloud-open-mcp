{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "huaweicloud-open-mcp": {
      "type": "local",
      "command": ["uv", "run", "huaweicloud-open-mcp", "--policy", "configs/safety-policy.example.json", "--mode", "data,openapi", "--hints", "help-docs-hints.json", "--deprecated-index", "deprecated.json", "--deprecated-mode", "hide", "--entity-index", "configs/entity-index.json"],
      "cwd": "./",
      "enabled": true
    }
  }
}
