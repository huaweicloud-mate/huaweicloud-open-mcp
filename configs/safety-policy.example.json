  "# server:@huaweicloud/ecs=allow",
  "# server:@huaweicloud/vpc=allow",
  "#",
  "# 格式二：控制 call_server_tool（toolPattern fnmatch 匹配工具名）",
  "# server:@huaweicloud/ecs:list*=allow",
  "# server:@huaweicloud/ecs:get*=allow",
  "# server:@huaweicloud/vpc:*=allow",
