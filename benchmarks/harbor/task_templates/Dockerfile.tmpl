FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /usr/local/bin/

WORKDIR /opt/hwc
COPY hwc/ /opt/hwc/

# 项目 + dev 依赖（pytest 等 verifier 需要），mcp 依赖在 build 期从 pypi 拉取
RUN uv sync --frozen --all-groups \
    && chmod +x /opt/hwc/start_mcp.sh /opt/hwc/start_services.sh

EXPOSE 8010
CMD ["bash", "/opt/hwc/start_services.sh"]
