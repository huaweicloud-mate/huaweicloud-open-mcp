      "expect": {
        "top1": "TMS"
      }
    },
    {
      "query": "专属主机分配虚拟机",
      "expect": {
        "top3": [
          "DeH",
          "ECS"
        ]
      },
      "note": "歧义：专属主机语境指 DeH，虚拟机 exact alias 指向 ECS——两可"
    },
    {
      "query": "k8s集群扩容",
      "expect": {
        "top1": "CCE"
      }
    },
    {
      "query": "容器集群升级",
      "expect": {
        "top1": "CCE"
      }
    },
    {
