{
  "version": 1,
  "note": "search_apis 金评集（人工标注，独立真值）。检查语义：top1=归并后首行产品必须等于该值；top3=期望产品须出现在前三甲；family=期望家族任一成员进前三甲即可（多 DB/近似服务混排的宽容档）。",
  "cases": [
    {
      "query": "重启服务器",
      "expect": {
        "top1": "ECS"
      }
    },
    {
      "query": "帮我把虚拟机重启一下",
      "expect": {
        "top1": "ECS"
      }
    },
    {
      "query": "查一下我的云服务器列表",
      "expect": {
        "top1": "ECS"
      }
    },
    {
      "query": "创建一台虚拟机",
      "expect": {
        "top1": "ECS"
      }
    },
    {
      "query": "裸金属服务器重装操作系统",
      "expect": {
        "top1": "BMS"
      }
    },
    {
      "query": "采购物理服务器",
      "expect": {
        "top1": "BMS"
      }
    },
    {
      "query": "给云主机打标签",
      "expect": {
        "top1": "ECS"
      }
    },
